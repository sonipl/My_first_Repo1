# Tesla Fleet API credentials — register at https://developer.tesla.com
TESLA_CLIENT_ID=your_client_id
TESLA_CLIENT_SECRET=your_client_secret
TESLA_AUTH_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3
TESLA_FLEET_API_URL=https://fleet-api.prd.na.vn.cloud.tesla.com

# OAuth redirect (use your backend URL in production)
TESLA_REDIRECT_URI=http://localhost:8000/auth/callback

# App security — change in production
APP_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./tesla_tracker.db

# Daily snapshot time (24h, server local time)
DAILY_SNAPSHOT_HOUR=23
DAILY_SNAPSHOT_MINUTE=55
